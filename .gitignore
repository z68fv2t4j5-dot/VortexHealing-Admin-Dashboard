# secrets and machine-specific values never enter the repository
.env
.env.*
!.env.example
# vendor skill folders are junctions to .agents/skills; recreate with: python scripts/harness_lint.py --doctor --relink
# (no trailing slash: on macOS they are symlinks, which a "dir/" pattern does not match)
.claude/skills
.agent/skills
# BMAD personal layers (team files are committed)
_bmad/config.user.toml
_bmad/custom/*.user.toml
# harness session state (transcript sync marker)
.harness/
# raw agent transcripts can contain student data; they stay on this machine (ADR-0005)
docs/sessions/raw/
# build, test and coverage output
coverage.xml
htmlcov/
.coverage
.pytest_cache/

# Student and class data stays local (AGENTS.md Part B)
*.db
*.csv
*.xlsx
*.numbers

# Python
__pycache__/
*.pyc

# Backend
backend/.venv
backend/venv/
backend/uploads/
backend/build/
backend/dist/
backend/*.egg-info/
backend/handouts_index.json

# Frontend
frontend/node_modules/
frontend/dist/
frontend/build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project

# OS
Thumbs.db

# Docker
.dockerignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
