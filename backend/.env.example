# Backend Environment Configuration
DATABASE_URL=sqlite:///./vortexhealing.db
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LM_STUDIO_URL=http://localhost:1234/v1
QWEN_MODEL=qwen/qwen3.8-27b
# The MLX file to load, its context, the embedder, and LM Studio's command-line tool (Handouts page: Load models)
QWEN_LOAD_KEY=qwen/qwen3.8-27b@4bit
QWEN_CONTEXT=32768
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LMS_PATH=~/.lmstudio/bin/lms
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@vortexhealing.com
FRONTEND_URL=http://localhost:3000
# Handouts knowledge base: the source folder and the data folder (outside the repository)
HANDOUTS_DIR=/path/to/Handouts-in-English
HANDOUTS_KB_DIR=~/Documents/Handouts-KB
# Optional: folder of class-transcript .md files; searchable on the Handouts page when set
TRANSCRIPTS_DIR=/path/to/Class-Transcripts
# Optional: pulling new Zoom transcripts into TRANSCRIPTS_DIR (python -m transcript_import zoom).
# The credentials file is a Zoom Server-to-Server OAuth app's keys; keep it outside the repository.
ZOOM_CREDENTIALS=/path/to/zoom_credentials.json
ZOOM_USER_ID=your-zoom-login@example.com
ZOOM_FOLDER=TeacherName
# Optional: the daily push digest (python -m app.digest). The topic is a random string and acts as a password.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=a-long-random-string
